---
import type { DocsPage } from '../lib/docs.js';

export interface Props {
  previous?: DocsPage;
  next?: DocsPage;
}

const { previous, next } = Astro.props;
---

{
  (previous !== undefined || next !== undefined) && (
    <nav class="pagination" aria-label="Previous and next page">
      {previous !== undefined && (
        <a class="pagination__link pagination__link--previous" href={previous.href} rel="prev">
          <span class="pagination__hint">Previous</span>
          <span class="pagination__title">{previous.title}</span>
        </a>
      )}
      {next !== undefined && (
        <a class="pagination__link pagination__link--next" href={next.href} rel="next">
          <span class="pagination__hint">Next</span>
          <span class="pagination__title">{next.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .pagination__link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--fg);
    text-decoration: none;
  }
  .pagination__link:hover {
    border-color: var(--line-strong);
    background: var(--surface-muted);
    color: var(--fg);
  }
  .pagination__link--previous {
    grid-column: 1;
  }
  .pagination__link--next {
    grid-column: 2;
    text-align: right;
  }
  .pagination__hint {
    color: var(--muted);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pagination__title {
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .pagination {
      grid-template-columns: 1fr;
    }
    .pagination__link--previous,
    .pagination__link--next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
