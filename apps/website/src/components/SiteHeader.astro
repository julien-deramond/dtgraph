---
import { siteSection, withBase } from '../lib/site.js';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const section = siteSection(base, Astro.url.pathname);
const links = [
  { href: withBase(base), label: 'Playground', section: 'playground' },
  { href: withBase(base, 'docs/'), label: 'Docs', section: 'docs' },
] as const;
---

<header class="site-header">
  <a class="site-header__brand" href={withBase(base)}>
    <svg class="site-header__mark" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 18 12 6l6 12M6 18h12" fill="none" stroke="currentColor" stroke-width="2"></path>
      <circle cx="12" cy="6" r="2.5"></circle>
      <circle cx="6" cy="18" r="2.5"></circle>
      <circle cx="18" cy="18" r="2.5"></circle>
    </svg>
    dtgraph
  </a>
  <nav class="site-header__nav" aria-label="Site">
    {
      links.map((link) => (
        <a href={link.href} aria-current={section === link.section ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <a
    class="btn site-header__star"
    href="https://github.com/julien-deramond/dtgraph"
    aria-label="Star dtgraph on GitHub"
    title="Star dtgraph on GitHub"
  >
    <svg class="site-header__star-mark" viewBox="0 0 16 16" aria-hidden="true">
      <path
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.05-.13-.36-.95.08-1.98 0 0 .67-.21 2.2.82a4.13 4.13 0 0 1 1.01-.14c.34 0 .69.05 1.01.14 1.53-1.04 2.2-.82 2.2-.82.44 1.03.13 1.85.08 1.98.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A7.995 7.995 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
      ></path>
    </svg>
    <span class="site-header__star-label">Star</span>
    <svg class="site-header__star-glyph" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="m12 3.5 2.6 5.56 5.9.77-4.3 4.2 1.08 6.02L12 17.15l-5.28 2.9L7.8 14.03l-4.3-4.2 5.9-.77L12 3.5Z"
      ></path>
    </svg>
  </a>
  <ThemeToggle />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: none;
    height: var(--header-height);
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-right: auto;
    font-weight: 700;
    color: var(--fg-strong);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .site-header__mark {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--accent);
  }
  .site-header__nav {
    display: flex;
    gap: 0.25rem;
  }
  .site-header__nav a {
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .site-header__nav a:hover {
    color: var(--fg);
    background: var(--surface-muted);
  }
  .site-header__nav a[aria-current='page'] {
    color: var(--fg-strong);
    background: var(--surface-muted);
  }
  /*
   * The one call to action in the header, so it reads as a button rather than a fourth nav
   * link: the GitHub mark names the destination, "Star" names the act, and the star glyph
   * fills in on hover as the nudge. Where the header gets tight the label drops and the two
   * icons carry it; the accessible name stays the full sentence either way.
   */
  .site-header__star {
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__star:hover {
    border-color: var(--line-strong);
    color: var(--fg-strong);
  }
  .site-header__star-mark {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }
  .site-header__star-glyph {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: fill 0.15s ease, stroke 0.15s ease;
  }
  .site-header__star:hover .site-header__star-glyph,
  .site-header__star:focus-visible .site-header__star-glyph {
    fill: var(--star);
    stroke: var(--star);
  }
  /*
   * global.css's .visually-hidden hides unconditionally; this label is only hidden on narrow
   * screens, so the same rules live here behind the breakpoint.
   */
  @media (max-width: 640px) {
    .site-header__star-label {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (max-width: 480px) {
    .site-header {
      gap: 0.75rem;
      padding-inline: 1rem;
    }
  }
</style>
