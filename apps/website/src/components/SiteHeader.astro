---
import { siteSection, withBase } from '../lib/site.js';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const section = siteSection(base, Astro.url.pathname);
const links = [
  { href: withBase(base), label: 'Playground', section: 'playground' },
  { href: withBase(base, 'docs/'), label: 'Docs', section: 'docs' },
] as const;
---

<header class="site-header">
  <a class="site-header__brand" href={withBase(base)}>
    <svg class="site-header__mark" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 18 12 6l6 12M6 18h12" fill="none" stroke="currentColor" stroke-width="2"></path>
      <circle cx="12" cy="6" r="2.5"></circle>
      <circle cx="6" cy="18" r="2.5"></circle>
      <circle cx="18" cy="18" r="2.5"></circle>
    </svg>
    dtgraph
  </a>
  <nav class="site-header__nav" aria-label="Site">
    {
      links.map((link) => (
        <a href={link.href} aria-current={section === link.section ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
    <a href="https://github.com/julien-deramond/dtgraph">GitHub</a>
  </nav>
  <ThemeToggle />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: none;
    height: var(--header-height);
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-right: auto;
    font-weight: 700;
    color: var(--fg-strong);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .site-header__mark {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--accent);
  }
  .site-header__nav {
    display: flex;
    gap: 0.25rem;
  }
  .site-header__nav a {
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .site-header__nav a:hover {
    color: var(--fg);
    background: var(--surface-muted);
  }
  .site-header__nav a[aria-current='page'] {
    color: var(--fg-strong);
    background: var(--surface-muted);
  }
  @media (max-width: 480px) {
    .site-header {
      gap: 0.75rem;
      padding-inline: 1rem;
    }
  }
</style>
