---
import { siteSection, withBase } from '../lib/site.js';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const section = siteSection(base, Astro.url.pathname);
const links = [
  { href: withBase(base), label: 'Playground', section: 'playground' },
  { href: withBase(base, 'docs/'), label: 'Docs', section: 'docs' },
] as const;
---

<header class="site-header">
  <a class="site-header__brand" href={withBase(base)}>
    <svg class="site-header__mark" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 18 12 6l6 12M6 18h12" fill="none" stroke="currentColor" stroke-width="2"></path>
      <circle cx="12" cy="6" r="2.5"></circle>
      <circle cx="6" cy="18" r="2.5"></circle>
      <circle cx="18" cy="18" r="2.5"></circle>
    </svg>
    dtgraph
  </a>
  <nav class="site-header__nav" aria-label="Site">
    {
      links.map((link) => (
        <a href={link.href} aria-current={section === link.section ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <a
    class="btn site-header__star"
    href="https://github.com/julien-deramond/dtgraph"
    aria-label="Star dtgraph on GitHub"
    title="Star dtgraph on GitHub"
  >
    <svg class="site-header__star-mark" viewBox="0 0 16 15.5" aria-hidden="true">
      <path
        d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"
      ></path>
    </svg>
    <span class="site-header__star-label">Star</span>
    <svg class="site-header__star-glyph" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="m12 3.5 2.6 5.56 5.9.77-4.3 4.2 1.08 6.02L12 17.15l-5.28 2.9L7.8 14.03l-4.3-4.2 5.9-.77L12 3.5Z"
      ></path>
    </svg>
  </a>
  <ThemeToggle />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: none;
    height: var(--header-height);
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-right: auto;
    font-weight: 700;
    color: var(--fg-strong);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .site-header__mark {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--accent);
  }
  .site-header__nav {
    display: flex;
    gap: 0.25rem;
  }
  .site-header__nav a {
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .site-header__nav a:hover {
    color: var(--fg);
    background: var(--surface-muted);
  }
  .site-header__nav a[aria-current='page'] {
    color: var(--fg-strong);
    background: var(--surface-muted);
  }
  /*
   * The one call to action in the header, so it reads as a button rather than a fourth nav
   * link: the GitHub mark names the destination, "Star" names the act, and the star glyph
   * fills in on hover as the nudge. Where the header gets tight the label drops and the two
   * icons carry it; the accessible name stays the full sentence either way.
   */
  .site-header__star {
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__star:hover {
    border-color: var(--line-strong);
    color: var(--fg-strong);
  }
  /*
   * Octicon's own mark-github-16 path, unaltered. Its artwork is 16 wide but only 15.5 tall and
   * sits flush with the top of the 16x16 box, so rendering it in a square left the Octocat a
   * third of a pixel above the label and the star beside it. Cropping the viewBox to the ink
   * lets `meet` center it instead; the mark still renders at the same size, since the width is
   * what the fit is bound by either way.
   *
   * 1.25rem, not the 1rem the rest of the header's icons use: at 20px the mark reads at the
   * weight of the text it sits next to, and it puts the button at the 2rem height of the theme
   * toggle beside it.
   */
  .site-header__star-mark {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }
  .site-header__star-glyph {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: fill 0.15s ease, stroke 0.15s ease;
  }
  .site-header__star:hover .site-header__star-glyph,
  .site-header__star:focus-visible .site-header__star-glyph {
    fill: var(--star);
    stroke: var(--star);
  }
  /*
   * global.css's .visually-hidden hides unconditionally; this label is only hidden on narrow
   * screens, so the same rules live here behind the breakpoint.
   */
  @media (max-width: 640px) {
    .site-header__star-label {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (max-width: 480px) {
    .site-header {
      gap: 0.75rem;
      padding-inline: 1rem;
    }
  }
</style>
