---
/**
 * The site-wide light/dark switch. It sets `<html data-theme>` (see src/lib/theme.ts), which
 * every surface follows: the CSS tokens, the playground's canvas and the docs' embedded graphs.
 * Rendered once in the header; the script applies a stored choice as soon as it runs, then
 * keeps the button's label in sync with whatever theme is in effect.
 */
---

<button
  type="button"
  class="btn btn--ghost btn--icon theme-toggle"
  data-theme-toggle
  aria-label="Switch to dark theme"
  title="Switch to dark theme"
>
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"
    ></path>
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    color: var(--muted);
  }
  .theme-toggle:hover {
    color: var(--fg);
  }
  .theme-toggle svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /*
   * Show the icon of the theme a click would switch to. light-dark() only takes colors, so the
   * two icons sit on top of each other and the one for the current theme gets a transparent
   * stroke — no duplicated media query and data-theme selectors needed.
   */
  .theme-toggle {
    position: relative;
  }
  .theme-toggle svg {
    position: absolute;
    inset: 0;
    margin: auto;
  }
  .theme-toggle .theme-toggle__sun {
    stroke: light-dark(transparent, currentColor);
  }
  .theme-toggle .theme-toggle__moon {
    stroke: light-dark(currentColor, transparent);
  }
</style>

<script>
  import { applyTheme, onSiteThemeChange, resolveSiteTheme, restoreStoredTheme } from '../lib/theme.js';

  restoreStoredTheme();

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const sync = (): void => {
    const next = resolveSiteTheme() === 'dark' ? 'light' : 'dark';
    // The tooltip and the accessible name are the same sentence: a title that says something
    // else is a second, contradictory label for the same control.
    for (const button of buttons) {
      button.setAttribute('aria-label', `Switch to ${next} theme`);
      button.setAttribute('title', `Switch to ${next} theme`);
    }
  };
  for (const button of buttons) {
    button.addEventListener('click', () => {
      applyTheme(resolveSiteTheme() === 'dark' ? 'light' : 'dark');
    });
  }
  sync();
  onSiteThemeChange(sync);
</script>
