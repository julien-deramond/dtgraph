---
/**
 * `@dtgraph/mdx`'s `<TokenGraph>` as the docs embed it: on the site's tokens (chrome and canvas;
 * the site has one theme, dark), in a hairline frame. Props pass through unchanged.
 */
import TokenGraph from '@dtgraph/mdx/TokenGraph.astro';
import type { ComponentProps } from 'astro/types';

import '../styles/viewer.css';
import { viewerTheme } from '../viewer-theme.js';

type Props = ComponentProps<typeof TokenGraph>;
---

<div class="token-graph">
  <TokenGraph theme={viewerTheme} {...Astro.props} />
</div>

<style>
  .token-graph :global(.dtgraph-mdx) {
    margin: var(--space-5) 0;
    border: var(--stroke-hairline) solid var(--color-line);
    border-radius: var(--radius-md);
  }
</style>
