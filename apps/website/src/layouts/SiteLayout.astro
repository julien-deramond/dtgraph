---
import { CSP_HEADER_VALUE } from '../lib/csp.js';

export interface Props {
  title: string;
  /** Let the page fill the viewport below the header, with no padding (the playground). */
  fullBleed?: boolean;
}

const { title, fullBleed = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={CSP_HEADER_VALUE} />
    <title>{title} — dtgraph</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={import.meta.env.BASE_URL}>dtgraph</a>
      <nav>
        <a href={import.meta.env.BASE_URL}>Playground</a>
        <a href={`${import.meta.env.BASE_URL}/docs/`.replace(/\/+/g, '/')}>Docs</a>
        <a href="https://github.com/julien-deramond/dtgraph">GitHub</a>
      </nav>
    </header>
    <main class:list={{ 'full-bleed': fullBleed }}>
      <slot />
    </main>
    <style is:global>
      /*
       * Shared with the playground's own scoped styles (src/pages/index.astro) — the two pages
       * are the only surfaces outside Starlight, which brings its own token set for /docs/*.
       * Values mirror Starlight's neutral/accent hues (gray hue 224, accent hue ~221) so the
       * chrome reads as one product rather than two.
       */
      :root {
        color-scheme: light dark;
        --bg: #ffffff;
        --surface: #ffffff;
        --surface-muted: #f9fafb;
        --fg: #18181b;
        --muted: #6b7280;
        --line: #e5e7eb;
        --accent: #2563eb;
        --accent-hover: #1d4ed8;
        --accent-fg: #ffffff;
        --accent-soft-bg: #eff6ff;
        --accent-soft-border: #93c5fd;
        --accent-soft-fg: #1d4ed8;
        --danger-fg: #b91c1c;
        --danger-bg: #fef2f2;
        --danger-border: #fecaca;
        --overlay-scrim: rgba(0, 0, 0, 0.4);
        --shadow-color: rgba(0, 0, 0, 0.25);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #17181c;
          --surface: #23262f;
          --surface-muted: #2b2e38;
          --fg: #edeef3;
          --muted: #9195a1;
          --line: #353841;
          --accent-hover: #3b82f6;
          --accent-soft-bg: #1c2942;
          --accent-soft-border: #3a5fc4;
          --accent-soft-fg: #93c5fd;
          --danger-fg: #fca5a5;
          --danger-bg: #3f1d1d;
          --danger-border: #7f1d1d;
          --overlay-scrim: rgba(0, 0, 0, 0.6);
          --shadow-color: rgba(0, 0, 0, 0.6);
        }
      }
      html,
      body {
        height: 100%;
        margin: 0;
      }
      body {
        display: flex;
        flex-direction: column;
        font-family: system-ui, sans-serif;
        color: var(--fg);
        background: var(--bg);
      }
      ::selection {
        background: var(--accent);
        color: var(--accent-fg);
      }
    </style>
    <style>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex: none;
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid var(--line);
      }
      .brand {
        font-weight: 700;
        text-decoration: none;
        color: inherit;
        border-radius: 0.25rem;
      }
      nav {
        display: flex;
        gap: 1.25rem;
      }
      nav a {
        color: inherit;
        text-decoration: none;
        border-radius: 0.25rem;
      }
      nav a:hover {
        text-decoration: underline;
      }
      .brand:focus-visible,
      nav a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      main {
        flex: 1 1 auto;
        min-height: 0;
        padding: 2rem 1.5rem;
      }
      main.full-bleed {
        display: flex;
        flex-direction: column;
        padding: 0;
      }
    </style>
  </body>
</html>
