---
import { CSP_HEADER_VALUE } from '../lib/csp.js';

export interface Props {
  title: string;
  /** Let the page fill the viewport below the header, with no padding (the playground). */
  fullBleed?: boolean;
}

const { title, fullBleed = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={CSP_HEADER_VALUE} />
    <title>{title} — dtgraph</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={import.meta.env.BASE_URL}>dtgraph</a>
      <nav>
        <a href={import.meta.env.BASE_URL}>Playground</a>
        <a href={`${import.meta.env.BASE_URL}/docs/`.replace(/\/+/g, '/')}>Docs</a>
        <a href="https://github.com/julien-deramond/dtgraph">GitHub</a>
      </nav>
    </header>
    <main class:list={{ 'full-bleed': fullBleed }}>
      <slot />
    </main>
    <style is:global>
      html,
      body {
        height: 100%;
        margin: 0;
      }
      body {
        display: flex;
        flex-direction: column;
        font-family: system-ui, sans-serif;
        color: #18181b;
        background: #ffffff;
      }
    </style>
    <style>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex: none;
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid #e5e7eb;
      }
      .brand {
        font-weight: 700;
        text-decoration: none;
        color: inherit;
      }
      nav {
        display: flex;
        gap: 1.25rem;
      }
      nav a {
        color: inherit;
        text-decoration: none;
      }
      nav a:hover {
        text-decoration: underline;
      }
      main {
        flex: 1 1 auto;
        min-height: 0;
        padding: 2rem 1.5rem;
      }
      main.full-bleed {
        display: flex;
        flex-direction: column;
        padding: 0;
      }
    </style>
  </body>
</html>
