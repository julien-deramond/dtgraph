---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — dtgraph</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">dtgraph</a>
      <nav>
        <a href="/">Playground</a>
        <a href="/docs/">Docs</a>
        <a href="https://github.com/julien-deramond/dtgraph">GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <style>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e5e7eb;
        font-family: system-ui, sans-serif;
      }
      .brand {
        font-weight: 700;
        text-decoration: none;
        color: inherit;
      }
      nav {
        display: flex;
        gap: 1.25rem;
      }
      nav a {
        color: inherit;
        text-decoration: none;
      }
      nav a:hover {
        text-decoration: underline;
      }
      main {
        font-family: system-ui, sans-serif;
        padding: 2rem 1.5rem;
      }
    </style>
  </body>
</html>
