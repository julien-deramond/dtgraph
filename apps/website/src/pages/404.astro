---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../lib/site.js';

const base = import.meta.env.BASE_URL;
---

<SiteLayout title="Page not found">
  <section class="not-found">
    <p class="not-found__code">404</p>
    <h1>Page not found</h1>
    <p>There is nothing at this address. Try the playground or the docs instead.</p>
    <p class="not-found__links">
      <a class="btn btn--primary" href={withBase(base)}>Open the playground</a>
      <a class="btn" href={withBase(base, 'docs/')}>Read the docs</a>
    </p>
  </section>
</SiteLayout>

<style>
  .not-found {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 4rem var(--gutter);
    text-align: center;
  }
  .not-found__code {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  h1 {
    margin: 0.25rem 0 0.75rem;
    font-size: var(--text-2xl);
    color: var(--fg-strong);
  }
  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .not-found__links a {
    text-decoration: none;
  }
</style>
