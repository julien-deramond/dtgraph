---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../lib/site.js';

const base = import.meta.env.BASE_URL;
---

<SiteLayout title="Page not found">
  <section class="not-found">
    <p class="not-found__code">404</p>
    <h1>Page not found</h1>
    <p>There is nothing at this address. Try the playground or the docs instead.</p>
    <p class="not-found__links">
      <a class="btn btn--primary" href={withBase(base)}>Open the playground</a>
      <a class="btn" href={withBase(base, 'docs/')}>Read the docs</a>
    </p>
  </section>
</SiteLayout>

<style>
  /*
   * <main> fills the viewport below the header, so the message sits in the middle of it
   * rather than clinging to the top of an otherwise empty page.
   */
  .not-found {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 4rem var(--gutter);
    text-align: center;
  }
  .not-found__code {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  h1 {
    margin: 0.25rem 0 0.75rem;
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--fg-strong);
  }
  .not-found p:not([class]) {
    max-width: var(--measure);
    margin: 0;
    color: var(--muted);
    font-size: var(--text-md);
  }
  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .not-found__links a {
    text-decoration: none;
  }
</style>
