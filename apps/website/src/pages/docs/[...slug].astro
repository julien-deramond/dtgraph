---
import { getCollection, render } from 'astro:content';

import DocsLayout from '../../layouts/DocsLayout.astro';
import { docsPages, docsSlug } from '../../lib/docs.js';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { slug: docsSlug(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pages = docsPages(import.meta.env.BASE_URL, await getCollection('docs'));
const page = pages.find((candidate) => candidate.id === entry.id);
if (page === undefined) throw new Error(`Docs entry "${entry.id}" is missing from the collection`);
---

<DocsLayout page={page} pages={pages} headings={headings}>
  <Content />
</DocsLayout>
