---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Playground" fullBleed>
  <div class="playground">
    <div class="toolbar" role="toolbar" aria-label="Playground controls">
      <div class="toolbar__group">
        <button id="open-files" type="button" class="btn btn--primary">Open files…</button>
        <input id="file-input" type="file" accept="application/json,.json" multiple hidden />
        <button id="paste-open" type="button" class="btn">Paste JSON</button>
        <button id="load-sample" type="button" class="btn btn--ghost">Load sample</button>
      </div>
      <div class="toolbar__status">
        <span id="file-chips" class="chips"></span>
        <span id="context-controls" class="contexts" role="group" aria-label="Resolver contexts"
        ></span>
        <span id="stats" class="stats"></span>
      </div>
      <div class="toolbar__group">
        <div class="segmented" role="group" aria-label="Color tokens by">
          <span class="segmented__label">Color by</span>
          <button type="button" data-color-by="group" aria-pressed="true">Group</button>
          <button type="button" data-color-by="type" aria-pressed="false">Type</button>
        </div>
        <button id="theme-toggle" type="button" class="btn" aria-pressed="true">Dark</button>
        <button id="fit" type="button" class="btn">Fit</button>
        <button id="export-svg" type="button" class="btn">Export SVG</button>
      </div>
    </div>

    <p id="error-output" class="error" role="alert" hidden></p>

    <div class="stage">
      <div id="graph-output" class="canvas"></div>
      <div class="hint" aria-hidden="true">
        Drag to pan · Scroll to zoom · Hover to spotlight · Double-click to dive in · Drop DTCG
        files anywhere
      </div>
      <div id="context-prompt" class="prompt" role="status" hidden></div>
      <div id="drop-overlay" class="drop-overlay" hidden>
        <div class="drop-overlay__card">Drop DTCG JSON file(s) to render them</div>
      </div>
    </div>

    <dialog id="paste-dialog" class="dialog">
      <form method="dialog">
        <h2>Paste DTCG JSON</h2>
        <textarea
          id="paste-input"
          rows="14"
          spellcheck="false"
          placeholder={'{\n  "color": {\n    "brand": { "$type": "color", "$value": "#3311ff" },\n    "accent": { "$value": "{color.brand}" }\n  }\n}'}
        ></textarea>
        <div class="dialog__actions">
          <button type="submit" value="cancel" class="btn">Cancel</button>
          <button type="submit" value="render" class="btn btn--primary">Render</button>
        </div>
      </form>
    </dialog>
  </div>

  <style>
    .playground {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      min-height: 0;
      background: var(--bg);
      color: var(--fg);
    }
    .toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1.25rem;
      padding: 0.6rem 1rem;
      border-bottom: 1px solid var(--line);
      font-size: 0.8125rem;
    }
    .toolbar__group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .toolbar__status {
      display: flex;
      flex: 1 1 20rem;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      color: var(--muted);
    }
    /*
     * File chips and context selectors are built at runtime by the script below, so they never
     * carry the scope class Astro adds to elements written in this template — a plain
     * `.chips > span` rule compiles to one that requires that class and silently matches
     * nothing. Anchor each rule to the scoped container and mark the generated child
     * `:global()`, which is what lets these reach it.
     */
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      min-width: 0;
    }
    .chips > :global(.chip) {
      flex: 0 0 auto;
      max-width: 14rem;
      overflow: hidden;
      padding: 0.15rem 0.5rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--fg);
      background: var(--surface-muted);
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .chips > :global(.chip--resolver) {
      border-color: var(--accent-soft-border);
      background: var(--accent-soft-bg);
      color: var(--accent-soft-fg);
    }
    .chips > :global(.chip--ignored) {
      color: var(--muted);
      text-decoration: line-through;
    }
    .chips > :global(.chip--toggle) {
      color: var(--accent);
      background: var(--surface);
      font: inherit;
      cursor: pointer;
    }
    .chips > :global(.chip--toggle:hover) {
      background: var(--surface-muted);
    }
    .contexts {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .contexts:empty {
      display: none;
    }
    .contexts :global(label) {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      white-space: nowrap;
    }
    .contexts :global(select) {
      padding: 0.1rem 0.3rem;
      border: 1px solid var(--line);
      border-radius: 0.35rem;
      color: inherit;
      background: var(--surface);
      font: inherit;
    }
    .contexts :global(select.select--unset) {
      border-color: var(--accent);
    }
    .stats {
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .btn,
    .segmented button {
      padding: 0.4rem 0.75rem;
      border: 1px solid var(--line);
      border-radius: 0.5rem;
      color: inherit;
      background: var(--surface);
      font: inherit;
      cursor: pointer;
    }
    .btn:hover,
    .segmented button:hover {
      background: var(--surface-muted);
    }
    .btn:focus-visible,
    .segmented button:focus-visible,
    textarea:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .btn--primary {
      border-color: var(--accent);
      color: var(--accent-fg);
      background: var(--accent);
      box-shadow: 0 1px 2px var(--shadow-color);
    }
    .btn--primary:hover {
      background: var(--accent-hover);
    }
    .btn--ghost {
      border-color: transparent;
    }
    .btn[aria-pressed='false'] {
      color: var(--muted);
    }
    .segmented {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .segmented__label {
      color: var(--muted);
    }
    .segmented button {
      border-radius: 0;
    }
    .segmented button:nth-of-type(1) {
      border-radius: 0.5rem 0 0 0.5rem;
    }
    .segmented button:nth-of-type(2) {
      margin-left: -1px;
      border-radius: 0 0.5rem 0.5rem 0;
    }
    .segmented button[aria-pressed='true'] {
      color: var(--bg);
      background: var(--fg);
      border-color: var(--fg);
    }
    .error {
      margin: 0;
      padding: 0.6rem 1rem;
      border-bottom: 1px solid var(--danger-border);
      color: var(--danger-fg);
      background: var(--danger-bg);
      font-size: 0.875rem;
      white-space: pre-wrap;
    }
    .stage {
      position: relative;
      flex: 1 1 auto;
      min-height: 320px;
    }
    .canvas {
      position: absolute;
      inset: 0;
    }
    .hint {
      position: absolute;
      left: 50%;
      bottom: 0.75rem;
      transform: translateX(-50%);
      max-width: calc(100% - 2rem);
      text-align: center;
      padding: 0.35rem 0.6rem;
      border-radius: 999px;
      color: rgba(255, 255, 255, 0.7);
      background: rgba(0, 0, 0, 0.45);
      font-size: 0.75rem;
      pointer-events: none;
    }
    .canvas[data-theme='light'] + .hint {
      color: rgba(0, 0, 0, 0.6);
      background: rgba(255, 255, 255, 0.7);
    }
    .prompt {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      max-width: min(30rem, calc(100% - 2rem));
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      padding: 1.25rem 1.5rem;
      border: 1px solid var(--line);
      border-radius: 0.75rem;
      color: var(--fg);
      background: var(--surface);
      box-shadow: 0 8px 24px var(--shadow-color);
      text-align: center;
    }
    .prompt[hidden] {
      display: none;
    }
    .prompt__title {
      margin: 0;
      font-size: 0.9375rem;
      font-weight: 600;
    }
    .prompt__help {
      margin: 0;
      color: var(--muted);
      font-size: 0.8125rem;
    }
    .prompt__controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 0.25rem;
    }
    .prompt__controls :global(label) {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      white-space: nowrap;
      font-size: 0.8125rem;
    }
    .prompt__controls :global(select) {
      padding: 0.25rem 0.4rem;
      border: 1px solid var(--accent);
      border-radius: 0.35rem;
      color: inherit;
      background: var(--surface);
      font: inherit;
    }
    .drop-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 3px dashed var(--accent);
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      pointer-events: none;
    }
    .drop-overlay[hidden] {
      display: none;
    }
    .drop-overlay__card {
      padding: 1rem 1.5rem;
      border-radius: 0.75rem;
      color: var(--accent-fg);
      background: var(--accent);
      font-weight: 600;
    }
    .dialog {
      width: min(40rem, 90vw);
      padding: 1.25rem;
      border: 1px solid var(--line);
      border-radius: 0.75rem;
      color: var(--fg);
      background: var(--surface);
      box-shadow: 0 20px 50px var(--shadow-color);
    }
    .dialog::backdrop {
      background: var(--overlay-scrim);
    }
    .dialog h2 {
      margin: 0 0 0.75rem;
      font-size: 1rem;
    }
    .dialog textarea {
      display: block;
      width: 100%;
      box-sizing: border-box;
      padding: 0.5rem;
      border: 1px solid var(--line);
      border-radius: 0.5rem;
      color: inherit;
      background: var(--surface-muted);
      font-family: ui-monospace, monospace;
      font-size: 0.8125rem;
    }
    .dialog__actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }
  </style>

  <script>
    import { mountTokenGraphViewer } from '@dtgraph/viewer';
    import type { ColorBy, TokenGraphViewer, ViewerTheme } from '@dtgraph/viewer';
    import '@dtgraph/viewer/style.css';

    import sample from '../samples/design-system.json';
    import { createPlayground, readFiles } from '../lib/playground.js';
    import type { PlaygroundModifier, PlaygroundResolver } from '../lib/playground.js';

    const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;
    const output = $<HTMLElement>('graph-output');
    const error = $<HTMLElement>('error-output');
    const fileInput = $<HTMLInputElement>('file-input');
    const chips = $<HTMLElement>('file-chips');
    const contextControls = $<HTMLElement>('context-controls');
    const contextPrompt = $<HTMLElement>('context-prompt');
    const stats = $<HTMLElement>('stats');
    const dropOverlay = $<HTMLElement>('drop-overlay');
    const pasteDialog = $<HTMLDialogElement>('paste-dialog');
    const pasteInput = $<HTMLTextAreaElement>('paste-input');
    const themeToggle = $<HTMLButtonElement>('theme-toggle');
    const colorButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('button[data-color-by]'),
    );

    let theme: ViewerTheme = 'dark';
    let colorBy: ColorBy = 'group';
    let viewer: TokenGraphViewer | undefined;

    const playground = createPlayground({ output, error }, (container, graph) => {
      viewer = mountTokenGraphViewer(container, graph, { theme, colorBy });
      return viewer;
    });

    const format = new Intl.NumberFormat();
    const count = (n: number, noun: string): string =>
      `${format.format(n)} ${noun}${n === 1 ? '' : 's'}`;

    /** Above this many files the row collapses to the resolver plus a count. */
    const CHIP_LIMIT = 4;
    let chipsExpanded = false;

    /** One file chip. File names are untrusted: textContent only, never markup. */
    function fileChip(file: { source: string }, resolver: PlaygroundResolver | undefined): HTMLElement {
      const chip = document.createElement('span');
      chip.className = 'chip';
      chip.textContent = file.source;
      chip.title = file.source;
      if (resolver?.source === file.source) {
        chip.classList.add('chip--resolver');
        chip.title = `${file.source} (resolver)`;
      } else if (resolver?.ignored.includes(file.source)) {
        chip.classList.add('chip--ignored');
        chip.title = `${file.source} (not referenced by the resolver for these contexts)`;
      }
      return chip;
    }

    function chipsToggle(hidden: number, keptAny: boolean): HTMLElement {
      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'chip chip--toggle';
      toggle.setAttribute('aria-expanded', String(chipsExpanded));
      toggle.textContent = chipsExpanded
        ? 'Show fewer'
        : count(hidden, keptAny ? 'more file' : 'file');
      toggle.addEventListener('click', () => {
        chipsExpanded = !chipsExpanded;
        reflect();
      });
      return toggle;
    }

    /**
     * A handful of files each get a chip. Past that the row would overflow the toolbar, so it
     * collapses to the resolver — the one file worth seeing at a glance — plus a count that
     * expands the rest on click.
     */
    function renderChips(resolver: PlaygroundResolver | undefined): void {
      const files = playground.files;
      const all = files.map((file) => fileChip(file, resolver));
      if (files.length <= CHIP_LIMIT) {
        chipsExpanded = false;
        chips.replaceChildren(...all);
        return;
      }
      if (chipsExpanded) {
        chips.replaceChildren(...all, chipsToggle(0, false));
        return;
      }
      const resolverIndex = files.findIndex((file) => file.source === resolver?.source);
      const kept = resolverIndex === -1 ? [] : [all[resolverIndex]];
      chips.replaceChildren(...kept, chipsToggle(files.length - kept.length, kept.length > 0));
    }

    /** One selector for a modifier. Modifier and context names are untrusted too. */
    function modifierSelect(modifier: PlaygroundModifier): HTMLElement {
      const label = document.createElement('label');
      label.append(`${modifier.name}:`);
      const select = document.createElement('select');
      // No default and nothing picked yet: the graph is waiting on this choice, so show it
      // unset rather than silently applying a context the resolver never asked for.
      if (modifier.selected === undefined) {
        const placeholder = document.createElement('option');
        placeholder.textContent = 'choose…';
        placeholder.disabled = true;
        placeholder.selected = true;
        select.append(placeholder);
        select.classList.add('select--unset');
      }
      for (const context of modifier.contexts) {
        const option = document.createElement('option');
        option.value = context;
        option.textContent = context;
        option.selected = context === modifier.selected;
        select.append(option);
      }
      select.addEventListener('change', () => {
        playground.setContext(modifier.name, select.value);
        reflect();
      });
      label.append(select);
      return label;
    }

    /**
     * A resolver whose modifier declares no default has an open question, not an error, so the
     * empty canvas states it and carries its own copy of the selectors rather than leaving a red
     * banner and a blank stage.
     */
    function renderPrompt(resolver: PlaygroundResolver | undefined): void {
      const pending = resolver?.pending ?? [];
      if (pending.length === 0) {
        contextPrompt.hidden = true;
        contextPrompt.replaceChildren();
        return;
      }
      const title = document.createElement('p');
      title.className = 'prompt__title';
      title.textContent =
        pending.length === 1
          ? `Choose a ${pending[0]} to render this resolver`
          : 'Choose a context for each modifier to render this resolver';
      const help = document.createElement('p');
      help.className = 'prompt__help';
      const quoted = pending.map((name) => `"${name}"`).join(', ');
      help.textContent =
        pending.length === 1
          ? `${quoted} declares no default context, so there is nothing to render until you pick one.`
          : `${quoted} declare no default context, so there is nothing to render until you pick one.`;
      const controls = document.createElement('div');
      controls.className = 'prompt__controls';
      controls.append(
        ...(resolver?.modifiers ?? [])
          .filter((modifier) => pending.includes(modifier.name))
          .map(modifierSelect),
      );
      contextPrompt.replaceChildren(title, help, controls);
      contextPrompt.hidden = false;
    }

    function reflect(): void {
      const resolver = playground.resolver;
      renderChips(resolver);
      contextControls.replaceChildren(...(resolver?.modifiers ?? []).map(modifierSelect));
      renderPrompt(resolver);
      const graph = playground.graph;
      stats.textContent =
        graph === undefined
          ? ''
          : `${count(graph.nodes.length, 'token')} · ${count(graph.edges.length, 'edge')}`;
    }

    function load(files: { source: string; content: string }[]): void {
      chipsExpanded = false;
      playground.load(files);
      reflect();
    }

    // --- Inputs -------------------------------------------------------------------------------
    $('open-files').addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', async () => {
      if (fileInput.files === null || fileInput.files.length === 0) return;
      load(await readFiles(fileInput.files));
      fileInput.value = '';
    });

    $('load-sample').addEventListener('click', () => {
      load([{ source: 'design-system.json', content: JSON.stringify(sample) }]);
    });

    $('paste-open').addEventListener('click', () => {
      pasteDialog.showModal();
      pasteInput.focus();
    });
    pasteDialog.addEventListener('close', () => {
      if (pasteDialog.returnValue !== 'render') return;
      load([{ source: 'pasted.json', content: pasteInput.value }]);
    });

    // Drop anywhere on the page.
    let dragDepth = 0;
    document.addEventListener('dragenter', (event) => {
      if (!event.dataTransfer?.types.includes('Files')) return;
      dragDepth += 1;
      dropOverlay.hidden = false;
    });
    document.addEventListener('dragleave', () => {
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) dropOverlay.hidden = true;
    });
    document.addEventListener('dragover', (event) => event.preventDefault());
    document.addEventListener('drop', async (event) => {
      event.preventDefault();
      dragDepth = 0;
      dropOverlay.hidden = true;
      const files = event.dataTransfer?.files;
      if (files === undefined || files.length === 0) return;
      load(await readFiles(files));
    });

    // --- Display options ------------------------------------------------------------------------
    for (const button of colorButtons) {
      button.addEventListener('click', () => {
        colorBy = button.dataset.colorBy as ColorBy;
        for (const other of colorButtons) {
          other.setAttribute('aria-pressed', String(other === button));
        }
        playground.remount();
      });
    }

    themeToggle.addEventListener('click', () => {
      theme = theme === 'dark' ? 'light' : 'dark';
      themeToggle.textContent = theme === 'dark' ? 'Dark' : 'Light';
      themeToggle.setAttribute('aria-pressed', String(theme === 'dark'));
      playground.remount();
    });

    $('fit').addEventListener('click', () => viewer?.fit());

    $('export-svg').addEventListener('click', () => {
      const svg = playground.exportSvg();
      if (svg === undefined) return;
      const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = 'token-graph.svg';
      link.click();
      URL.revokeObjectURL(url);
    });

    // --- Land with something on screen -------------------------------------------------------
    load([{ source: 'design-system.json', content: JSON.stringify(sample) }]);
  </script>
</SiteLayout>
