---
import { Button, DocsLayout } from '@deramond.dev/astro';

import { CSP_HEADER_VALUE } from '../lib/csp.js';
import '../styles/viewer.css';
---

<DocsLayout title="Playground" wide>
  <meta slot="head" http-equiv="Content-Security-Policy" content={CSP_HEADER_VALUE} />
  <a slot="links" href="https://github.com/julien-deramond/dtgraph">GitHub</a>
  <div class="playground">
    {/* The page is one full-bleed tool, so its heading is spoken rather than drawn. */}
    <h1 class="d-visually-hidden">DTCG token graph playground</h1>
    {/*
      A labelled region, not role="toolbar": that role promises arrow-key navigation between
      the controls, and these are ordinary tab stops.
    */}
    <div class="toolbar" role="group" aria-label="Playground controls">
      <div class="toolbar__group">
        {/* Opening your own files is the page's one decision, so it alone is gold. */}
        <Button id="open-files" type="button" variant="gold" size="sm">Open files…</Button>
        <input id="file-input" type="file" accept="application/json,.json" multiple hidden />
        <Button id="paste-open" type="button" variant="quiet" size="sm">Paste JSON</Button>
        <Button id="load-sample" type="button" variant="quiet" size="sm">Load sample</Button>
      </div>
      <div class="toolbar__status">
        <span id="file-chips" class="chips"></span>
        <span id="context-controls" class="contexts" role="group" aria-label="Resolver contexts"
        ></span>
        <span id="stats" class="stats"></span>
      </div>
      <div class="toolbar__group">
        <div class="segmented" role="group" aria-label="Color tokens by">
          <span class="segmented__label">Color by</span>
          <Button type="button" variant="quiet" size="sm" data-color-by="group" aria-pressed="true"
            >Group</Button
          >
          <Button type="button" variant="quiet" size="sm" data-color-by="type" aria-pressed="false"
            >Type</Button
          >
        </div>
        <Button id="fit" type="button" variant="quiet" size="sm">Fit</Button>
        <Button id="export-svg" type="button" variant="quiet" size="sm">Export SVG</Button>
      </div>
    </div>

    <p id="error-output" class="error" role="alert" hidden></p>

    <div class="stage">
      <div id="graph-output" class="canvas"></div>
      {/*
        How the map is driven — the only place it is stated, so it stays readable to assistive
        technology instead of being decoration. The middle two gestures drop out on a phone,
        where they do not apply and the full string covered a quarter of the canvas.
      */}
      <p id="hint" class="hint" hidden>
        Drag to pan · Pinch or scroll to zoom<span class="hint__wide">
           · Hover to spotlight · Double-click to dive in</span
        > · Drop DTCG files anywhere
      </p>
      <div id="context-prompt" class="prompt" role="status" hidden></div>
      <div id="drop-overlay" class="drop-overlay" hidden>
        <div class="drop-overlay__card">Drop DTCG JSON file(s) to render them</div>
      </div>
    </div>

    <dialog id="paste-dialog" class="dialog">
      <form method="dialog">
        <h2>Paste DTCG JSON</h2>
        <textarea
          id="paste-input"
          rows="14"
          spellcheck="false"
          placeholder={'{\n  "color": {\n    "brand": { "$type": "color", "$value": "#3311ff" },\n    "accent": { "$value": "{color.brand}" }\n  }\n}'}
        ></textarea>
        <div class="dialog__actions">
          <Button type="submit" value="cancel" variant="quiet" size="sm">Cancel</Button>
          <Button type="submit" value="render" variant="gold" size="sm">Render</Button>
        </div>
      </form>
    </dialog>
  </div>

  <style>
    /*
     * The docs shell's top bar and status strip sit above the page; the playground takes the
     * rest of the viewport, as the full-bleed tool it is.
     */
    .playground {
      display: flex;
      flex-direction: column;
      height: calc(100dvh - var(--layout-docs-top) - 2rem);
      min-height: 28rem;
      background: var(--color-bg);
      color: var(--color-fg);
    }
    .toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-5);
      padding: var(--space-3) var(--space-5);
      border-bottom: var(--stroke-hairline) solid var(--color-line);
      font-size: var(--font-size-xs);
    }
    .toolbar__group {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
    .toolbar__status {
      display: flex;
      flex: 1 1 20rem;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-muted);
      font: var(--type-mono);
      font-size: var(--font-size-xs);
    }
    /*
     * File chips and context selectors are built at runtime by the script below, so they never
     * carry the scope class Astro adds to elements written in this template — a plain
     * `.chips > span` rule compiles to one that requires that class and silently matches
     * nothing. Anchor each rule to the scoped container and mark the generated child
     * `:global()`, which is what lets these reach it.
     */
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
      min-width: 0;
    }
    .chips > :global(.chip) {
      flex: 0 0 auto;
      max-width: 14rem;
      overflow: hidden;
      padding: 2px var(--space-2);
      border: var(--stroke-hairline) solid var(--color-line);
      border-radius: var(--radius-pill);
      color: var(--color-fg);
      background: var(--color-panel);
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .chips > :global(.chip--resolver) {
      border-color: var(--color-primary-dim);
      background: var(--color-tint);
      color: var(--color-primary);
    }
    .chips > :global(.chip--ignored) {
      color: var(--color-muted);
      text-decoration: line-through;
    }
    .chips > :global(.chip--toggle) {
      color: var(--color-primary);
      background: transparent;
      font: inherit;
      cursor: pointer;
    }
    .chips > :global(.chip--toggle:hover) {
      border-color: var(--color-primary);
    }
    .contexts {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
    }
    .contexts:empty {
      display: none;
    }
    .contexts :global(label) {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      white-space: nowrap;
    }
    .contexts :global(select) {
      padding: 2px var(--space-1);
      border: var(--stroke-hairline) solid var(--color-line);
      border-radius: var(--radius-sm);
      color: inherit;
      background: var(--color-panel);
      font: inherit;
    }
    .contexts :global(select.select--unset) {
      border-color: var(--color-primary);
    }
    .stats {
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    /*
     * The two halves are ordinary buttons (the package's Button owns their padding, border and
     * hover); only the joined radii and the pressed state belong to the group.
     */
    .segmented {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
    }
    .segmented__label {
      margin-right: var(--space-1);
      white-space: nowrap;
      color: var(--color-muted);
    }
    .segmented :global(.d-btn:nth-of-type(1)) {
      border-radius: var(--radius-md) 0 0 var(--radius-md);
    }
    .segmented :global(.d-btn:nth-of-type(2)) {
      margin-left: calc(-1 * var(--space-1) - 1.5px);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
    }
    .segmented :global(.d-btn[aria-pressed='true']) {
      position: relative;
      border-color: var(--color-primary);
      background: var(--color-tint);
      color: var(--color-primary);
    }
    .error {
      margin: 0;
      padding: var(--space-3) var(--space-5);
      border-bottom: var(--stroke-hairline) solid var(--color-danger);
      color: var(--color-danger);
      background: var(--color-panel);
      font-size: var(--font-size-sm);
      white-space: pre-wrap;
    }
    .stage {
      position: relative;
      flex: 1 1 auto;
      min-height: 320px;
    }
    .canvas {
      position: absolute;
      inset: 0;
    }
    .hint {
      position: absolute;
      left: 50%;
      bottom: var(--space-3);
      transform: translateX(-50%);
      max-width: calc(100% - 2rem);
      margin: 0;
      text-align: center;
      text-wrap: balance;
      padding: var(--space-1) var(--space-3);
      border: var(--stroke-hairline) solid var(--color-line);
      border-radius: var(--radius-pill);
      color: var(--color-muted);
      background: color-mix(in srgb, var(--color-panel) 88%, transparent);
      font-size: var(--font-size-xs);
      line-height: 1.5;
      pointer-events: none;
    }
    .hint[hidden] {
      display: none;
    }
    /* Hover and double-click have no phone equivalent, and the full string ate the canvas. */
    @media (max-width: 600px), (hover: none) {
      .hint__wide {
        display: none;
      }
    }
    .prompt {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      max-width: min(30rem, calc(100% - 2rem));
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-5) var(--space-6);
      border: var(--stroke-hairline) solid var(--color-line);
      border-radius: var(--radius-md);
      color: var(--color-fg);
      background: var(--color-panel);
      text-align: center;
    }
    .prompt[hidden] {
      display: none;
    }
    .prompt__title {
      margin: 0;
      font-size: var(--font-size-md);
      font-weight: var(--font-weight-semibold);
    }
    .prompt__help {
      margin: 0;
      color: var(--color-muted);
      font-size: var(--font-size-sm);
    }
    .prompt__controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-2);
      margin-top: var(--space-1);
    }
    .prompt__controls :global(label) {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      white-space: nowrap;
      font-size: var(--font-size-sm);
    }
    .prompt__controls :global(select) {
      padding: var(--space-1);
      border: var(--stroke-hairline) solid var(--color-primary);
      border-radius: var(--radius-sm);
      color: inherit;
      background: var(--color-panel);
      font: inherit;
    }
    .drop-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border: var(--stroke-bracket) dashed var(--color-primary);
      background: color-mix(in srgb, var(--color-primary) 12%, transparent);
      pointer-events: none;
    }
    .drop-overlay[hidden] {
      display: none;
    }
    .drop-overlay__card {
      padding: var(--space-4) var(--space-6);
      border-radius: var(--radius-md);
      color: var(--color-on-primary);
      background: var(--color-primary);
      font-weight: var(--font-weight-semibold);
    }
    .dialog {
      width: min(40rem, 90vw);
      padding: var(--space-5);
      border: var(--stroke-hairline) solid var(--color-line);
      border-radius: var(--radius-md);
      color: var(--color-fg);
      background: var(--color-panel);
    }
    .dialog::backdrop {
      background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    }
    .dialog h2 {
      margin: 0 0 var(--space-3);
      font-size: var(--font-size-md);
    }
    .dialog textarea {
      display: block;
      width: 100%;
      box-sizing: border-box;
      padding: var(--space-2);
      border: var(--stroke-hairline) solid var(--color-line);
      border-radius: var(--radius-sm);
      color: inherit;
      background: var(--color-bg);
      font: var(--type-mono);
      font-size: var(--font-size-xs);
    }
    .dialog__actions {
      display: flex;
      justify-content: flex-end;
      gap: var(--space-2);
      margin-top: var(--space-3);
    }
  </style>

  <script>
    import { mountTokenGraphViewer } from '@dtgraph/viewer';
    import type { ColorBy, TokenGraphViewer } from '@dtgraph/viewer';
    import '@dtgraph/viewer/style.css';

    import sample from '../samples/design-system.json';
    import { createPlayground, readFiles } from '../lib/playground.js';
    import type { PlaygroundModifier, PlaygroundResolver } from '../lib/playground.js';

    const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;
    const output = $<HTMLElement>('graph-output');
    const error = $<HTMLElement>('error-output');
    const fileInput = $<HTMLInputElement>('file-input');
    const chips = $<HTMLElement>('file-chips');
    const contextControls = $<HTMLElement>('context-controls');
    const contextPrompt = $<HTMLElement>('context-prompt');
    const stats = $<HTMLElement>('stats');
    const dropOverlay = $<HTMLElement>('drop-overlay');
    const pasteDialog = $<HTMLDialogElement>('paste-dialog');
    const pasteInput = $<HTMLTextAreaElement>('paste-input');
    const fitButton = $<HTMLButtonElement>('fit');
    const exportButton = $<HTMLButtonElement>('export-svg');
    const hint = $<HTMLElement>('hint');
    const colorButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('button[data-color-by]'),
    );

    let colorBy: ColorBy = 'group';
    let viewer: TokenGraphViewer | undefined;

    let tokenOpen = false;

    const playground = createPlayground({ output, error }, (container, graph) => {
      tokenOpen = false;
      const mounted = mountTokenGraphViewer(container, graph, {
        // The site has one theme, dark, and the canvas matches it.
        theme: 'dark',
        colorBy,
        onSelect: (token) => {
          tokenOpen = token !== undefined;
          syncHint();
        },
      });
      viewer = mounted;
      // Let go of the instance when the playground swaps it out, so the toolbar never drives
      // (or exports) a torn-down map after a load that left nothing on screen.
      return {
        destroy() {
          mounted.destroy();
          if (viewer === mounted) viewer = undefined;
        },
      };
    });

    /*
     * The hint is onboarding, so it goes as soon as it has nothing to say: no graph to drive, or
     * a token already open — on a narrow screen the viewer's detail panel is a sheet that comes
     * up from the bottom, exactly where this pill sits.
     */
    function syncHint(): void {
      hint.hidden = playground.graph === undefined || tokenOpen;
    }

    const format = new Intl.NumberFormat();
    const count = (n: number, noun: string): string =>
      `${format.format(n)} ${noun}${n === 1 ? '' : 's'}`;

    /** Above this many files the row collapses to the resolver plus a count. */
    const CHIP_LIMIT = 4;
    let chipsExpanded = false;

    /** One file chip. File names are untrusted: textContent only, never markup. */
    function fileChip(file: { source: string }, resolver: PlaygroundResolver | undefined): HTMLElement {
      const chip = document.createElement('span');
      chip.className = 'chip';
      chip.textContent = file.source;
      chip.title = file.source;
      if (resolver?.source === file.source) {
        chip.classList.add('chip--resolver');
        chip.title = `${file.source} (resolver)`;
      } else if (resolver?.ignored.includes(file.source)) {
        chip.classList.add('chip--ignored');
        chip.title = `${file.source} (not referenced by the resolver for these contexts)`;
      }
      return chip;
    }

    function chipsToggle(hidden: number, keptAny: boolean): HTMLElement {
      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'chip chip--toggle';
      toggle.setAttribute('aria-expanded', String(chipsExpanded));
      toggle.textContent = chipsExpanded
        ? 'Show fewer'
        : count(hidden, keptAny ? 'more file' : 'file');
      toggle.addEventListener('click', () => {
        chipsExpanded = !chipsExpanded;
        reflect();
      });
      return toggle;
    }

    /**
     * A handful of files each get a chip. Past that the row would overflow the toolbar, so it
     * collapses to the resolver — the one file worth seeing at a glance — plus a count that
     * expands the rest on click.
     */
    function renderChips(resolver: PlaygroundResolver | undefined): void {
      const files = playground.files;
      const all = files.map((file) => fileChip(file, resolver));
      if (files.length <= CHIP_LIMIT) {
        chipsExpanded = false;
        chips.replaceChildren(...all);
        return;
      }
      if (chipsExpanded) {
        chips.replaceChildren(...all, chipsToggle(0, false));
        return;
      }
      const resolverIndex = files.findIndex((file) => file.source === resolver?.source);
      const kept = resolverIndex === -1 ? [] : [all[resolverIndex]];
      chips.replaceChildren(...kept, chipsToggle(files.length - kept.length, kept.length > 0));
    }

    /** One selector for a modifier. Modifier and context names are untrusted too. */
    function modifierSelect(modifier: PlaygroundModifier): HTMLElement {
      const label = document.createElement('label');
      label.append(`${modifier.name}:`);
      const select = document.createElement('select');
      // No default and nothing picked yet: the graph is waiting on this choice, so show it
      // unset rather than silently applying a context the resolver never asked for.
      if (modifier.selected === undefined) {
        const placeholder = document.createElement('option');
        placeholder.textContent = 'choose…';
        placeholder.disabled = true;
        placeholder.selected = true;
        select.append(placeholder);
        select.classList.add('select--unset');
      }
      for (const context of modifier.contexts) {
        const option = document.createElement('option');
        option.value = context;
        option.textContent = context;
        option.selected = context === modifier.selected;
        select.append(option);
      }
      select.addEventListener('change', () => {
        playground.setContext(modifier.name, select.value);
        reflect();
      });
      label.append(select);
      return label;
    }

    /**
     * A resolver whose modifier declares no default has an open question, not an error, so the
     * empty canvas states it and carries its own copy of the selectors rather than leaving a red
     * banner and a blank stage.
     */
    function renderPrompt(resolver: PlaygroundResolver | undefined): void {
      const pending = resolver?.pending ?? [];
      if (pending.length === 0) {
        contextPrompt.hidden = true;
        contextPrompt.replaceChildren();
        return;
      }
      const title = document.createElement('p');
      title.className = 'prompt__title';
      title.textContent =
        pending.length === 1
          ? `Choose a ${pending[0]} to render this resolver`
          : 'Choose a context for each modifier to render this resolver';
      const help = document.createElement('p');
      help.className = 'prompt__help';
      const quoted = pending.map((name) => `"${name}"`).join(', ');
      help.textContent =
        pending.length === 1
          ? `${quoted} declares no default context, so there is nothing to render until you pick one.`
          : `${quoted} declare no default context, so there is nothing to render until you pick one.`;
      const controls = document.createElement('div');
      controls.className = 'prompt__controls';
      controls.append(
        ...(resolver?.modifiers ?? [])
          .filter((modifier) => pending.includes(modifier.name))
          .map(modifierSelect),
      );
      contextPrompt.replaceChildren(title, help, controls);
      contextPrompt.hidden = false;
    }

    function reflect(): void {
      const resolver = playground.resolver;
      renderChips(resolver);
      contextControls.replaceChildren(...(resolver?.modifiers ?? []).map(modifierSelect));
      renderPrompt(resolver);
      const graph = playground.graph;
      stats.textContent =
        graph === undefined
          ? ''
          : `${count(graph.nodes.length, 'token')} · ${count(graph.edges.length, 'edge')}`;
      // Nothing rendered — a file failed to parse, or a resolver is still waiting on a
      // context — so there is nothing to fit, export, or pan around. Say so instead of
      // ignoring the click and advertising gestures over an empty canvas.
      fitButton.disabled = graph === undefined;
      exportButton.disabled = graph === undefined;
      syncHint();
    }

    function load(files: { source: string; content: string }[]): void {
      chipsExpanded = false;
      playground.load(files);
      reflect();
    }

    // --- Inputs -------------------------------------------------------------------------------
    $('open-files').addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', async () => {
      if (fileInput.files === null || fileInput.files.length === 0) return;
      load(await readFiles(fileInput.files));
      fileInput.value = '';
    });

    $('load-sample').addEventListener('click', () => {
      load([{ source: 'design-system.json', content: JSON.stringify(sample) }]);
    });

    $('paste-open').addEventListener('click', () => {
      pasteDialog.showModal();
      pasteInput.focus();
    });
    pasteDialog.addEventListener('close', () => {
      if (pasteDialog.returnValue !== 'render') return;
      load([{ source: 'pasted.json', content: pasteInput.value }]);
    });

    // Drop anywhere on the page.
    let dragDepth = 0;
    document.addEventListener('dragenter', (event) => {
      if (!event.dataTransfer?.types.includes('Files')) return;
      dragDepth += 1;
      dropOverlay.hidden = false;
    });
    document.addEventListener('dragleave', () => {
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) dropOverlay.hidden = true;
    });
    document.addEventListener('dragover', (event) => event.preventDefault());
    document.addEventListener('drop', async (event) => {
      event.preventDefault();
      dragDepth = 0;
      dropOverlay.hidden = true;
      const files = event.dataTransfer?.files;
      if (files === undefined || files.length === 0) return;
      load(await readFiles(files));
    });

    // --- Display options ------------------------------------------------------------------------
    for (const button of colorButtons) {
      button.addEventListener('click', () => {
        colorBy = button.dataset.colorBy as ColorBy;
        for (const other of colorButtons) {
          other.setAttribute('aria-pressed', String(other === button));
        }
        playground.remount();
      });
    }

    fitButton.addEventListener('click', () => viewer?.fit());

    exportButton.addEventListener('click', () => {
      // What you see: the mounted viewer serializes its own map (layout, palette, dot sizes)
      // and whatever it is spotlighting — a selected token's chains, a solo'd legend group.
      // Without one — no WebGL, nothing loaded — fall back to core's static list rendering.
      const svg = viewer?.toSvg() ?? playground.exportSvg();
      if (svg === undefined) return;
      const url = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = 'token-graph.svg';
      link.click();
      URL.revokeObjectURL(url);
    });

    // --- Land with something on screen -------------------------------------------------------
    load([{ source: 'design-system.json', content: JSON.stringify(sample) }]);
  </script>
</DocsLayout>
