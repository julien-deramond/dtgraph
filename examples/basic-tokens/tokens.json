{
  "color": {
    "blue-500": { "$type": "color", "$value": "#3b82f6" },
    "gray-900": { "$type": "color", "$value": "#111827" }
  },
  "spacing": {
    "sm": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
    "md": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } }
  },
  "button": {
    "primary": {
      "background": { "$value": "{color.blue-500}" },
      "text": { "$value": "{color.gray-900}" }
    },
    "border": {
      "$type": "border",
      "$value": {
        "color": "{color.gray-900}",
        "width": { "value": 1, "unit": "px" },
        "style": "solid"
      }
    }
  }
}
