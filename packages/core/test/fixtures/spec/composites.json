{
  "stroke-style": {
    "focus-ring-style": {
      "$type": "strokeStyle",
      "$value": "dashed"
    },
    "dash-length-medium": {
      "$type": "dimension",
      "$value": { "value": 10, "unit": "px" }
    },
    "dash-gap-short": {
      "$type": "dimension",
      "$value": { "value": 0.25, "unit": "rem" }
    },
    "notification-border-style": {
      "$type": "strokeStyle",
      "$value": {
        "dashArray": ["{stroke-style.dash-length-medium}", "{stroke-style.dash-gap-short}"],
        "lineCap": "butt"
      }
    }
  },
  "color": {
    "focusring": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.9] }
    },
    "brand-accent": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0, 1, 0.4] }
    }
  },
  "border": {
    "heavy": {
      "$type": "border",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0.218, 0.218, 0.218] },
        "width": { "value": 3, "unit": "px" },
        "style": "solid"
      }
    },
    "focusring": {
      "$type": "border",
      "$value": {
        "color": "{color.focusring}",
        "width": { "value": 1, "unit": "px" },
        "style": {
          "dashArray": [
            { "value": 0.5, "unit": "rem" },
            { "value": 0.25, "unit": "rem" }
          ],
          "lineCap": "round"
        }
      }
    }
  },
  "transition": {
    "emphasis": {
      "$type": "transition",
      "$value": {
        "duration": { "value": 200, "unit": "ms" },
        "delay": { "value": 0, "unit": "ms" },
        "timingFunction": [0.5, 0, 1, 1]
      }
    }
  },
  "shadow": {
    "base": {
      "$type": "shadow",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.5 },
        "offsetX": { "value": 0.5, "unit": "rem" },
        "offsetY": { "value": 0.5, "unit": "rem" },
        "blur": { "value": 1.5, "unit": "rem" },
        "spread": { "value": 0, "unit": "rem" }
      }
    },
    "mixed-reference": {
      "$type": "shadow",
      "$value": [
        "{shadow.base}",
        {
          "color": "{color.brand-accent}",
          "offsetX": { "value": 2, "unit": "px" },
          "offsetY": { "value": 2, "unit": "px" },
          "blur": { "value": 4, "unit": "px" },
          "spread": { "value": 1, "unit": "px" }
        }
      ]
    },
    "inner": {
      "$type": "shadow",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.5 },
        "offsetX": { "value": 2, "unit": "px" },
        "offsetY": { "value": 2, "unit": "px" },
        "blur": { "value": 4, "unit": "px" },
        "spread": { "value": 0, "unit": "px" },
        "inset": true
      }
    }
  },
  "gradient": {
    "start-stop": {
      "$type": "gradient",
      "$value": [
        { "color": "#0000ff", "position": 0 },
        { "color": "#ff0000", "position": 1 }
      ]
    },
    "end-stop": {
      "$type": "gradient",
      "$value": [{ "color": "#00ff66", "position": 0.5 }]
    },
    "with-references": {
      "$type": "gradient",
      "$value": [
        "{gradient.start-stop}",
        { "color": "{color.brand-accent}", "position": 0.5 },
        "{gradient.end-stop}"
      ]
    }
  },
  "font": {
    "serif": { "$type": "fontFamily", "$value": "Georgia" },
    "size": {
      "smallest": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } }
    },
    "weight": {
      "normal": { "$type": "fontWeight", "$value": "normal" }
    }
  },
  "typography": {
    "heading-level-1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Roboto",
        "fontSize": { "value": 42, "unit": "px" },
        "fontWeight": 700,
        "letterSpacing": { "value": 0.1, "unit": "px" },
        "lineHeight": 1.2
      }
    },
    "microcopy": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontSize": "{font.size.smallest}",
        "fontWeight": "{font.weight.normal}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1
      }
    }
  }
}
