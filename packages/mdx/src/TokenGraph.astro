---
import { readFileSync } from 'node:fs';

import {
  buildTokenGraph,
  DtcgParseError,
  flattenTokenTree,
  parseTokenTree,
  resolveAliasEdgesAcrossFiles,
  renderTokenGraphToSvg,
} from '@dtgraph/core';
import type { NamedTokenTree } from '@dtgraph/core';
import type { ThemeColors } from '@dtgraph/viewer';

export interface Props {
  /** Inline DTCG JSON (already parsed), e.g. imported from a `.json` file. */
  tokens?: unknown;
  /**
   * Path to a DTCG JSON file to read at build time, resolved relative to the current working
   * directory (typically the Astro project root — the directory the `astro dev`/`astro build`
   * command runs from). A path relative to the importing file itself (e.g. via
   * `import.meta.url`) is not reliable here: Astro bundles and relocates frontmatter scripts
   * at build time, which breaks paths resolved that way in the production build even though
   * they may appear to work in `astro dev`.
   */
  file?: string;
  /** Multiple file paths (see `file`) — aliases resolve across all of them, same as the CLI. */
  files?: string[];
  /**
   * Render the interactive map (`@dtgraph/viewer`) instead of the static SVG: pan, zoom, hover,
   * search, and a detail panel, hydrated on the client. The graph is still parsed and resolved
   * at build time; only the resolved nodes/edges ship to the browser.
   */
  interactive?: boolean;
  /** Interactive only: CSS height of the map. Defaults to `480px`. */
  height?: string;
  /**
   * Interactive only: `"auto"` (default) follows `<html data-theme="…">` when the site sets it
   * (Starlight does) and `prefers-color-scheme` otherwise, live; force `"dark"`/`"light"`; or
   * pass a full set of canvas colors (`ThemeColors` from `@dtgraph/viewer`) for a site's own
   * palette and background.
   */
  theme?: 'auto' | 'dark' | 'light' | ThemeColors;
  /** Interactive only: color tokens by top-level group (default) or by `$type`. */
  colorBy?: 'group' | 'type';
  /** Interactive only: show the search box, legend and detail panel. Defaults to `true`. */
  chrome?: boolean;
}

const {
  tokens,
  file,
  files,
  interactive = false,
  height = '480px',
  theme = 'auto',
  colorBy = 'group',
  chrome = true,
} = Astro.props;

const namedTrees: NamedTokenTree[] = [];
if (tokens !== undefined) {
  namedTrees.push({ source: 'tokens', tree: parseTokenTree(tokens) });
}
for (const path of files ?? (file !== undefined ? [file] : [])) {
  namedTrees.push({ source: path, tree: parseTokenTree(JSON.parse(readFileSync(path, 'utf8'))) });
}

if (namedTrees.length === 0) {
  throw new DtcgParseError(
    '<TokenGraph> requires a "tokens" prop (inline DTCG JSON) or a "file"/"files" prop (path(s) to DTCG JSON file(s))',
    [],
  );
}

const nodes = namedTrees.flatMap(({ tree }) => flattenTokenTree(tree));
const edges = resolveAliasEdgesAcrossFiles(namedTrees);
const graph = buildTokenGraph(nodes, edges);

// Static mode: the SVG is safe as-is — renderTokenGraphToSvg escapes every piece of
// token-derived text it contains.
const svg = interactive ? undefined : renderTokenGraphToSvg(graph);

// Interactive mode: the resolved graph rides along as JSON in a non-executable script element.
// `<`, U+2028 and U+2029 are escaped so no token text can close the element or break parsing,
// whatever the token file contains.
const payload = interactive
  ? JSON.stringify({ nodes: graph.nodes, edges: graph.edges })
      .replace(/</g, '\\u003c')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029')
  : undefined;
---

{svg !== undefined && <Fragment set:html={svg} />}
{
  payload !== undefined && (
    <div
      class="dtgraph-mdx"
      data-dtgraph-interactive
      data-dtgraph-theme={typeof theme === 'object' ? JSON.stringify(theme) : theme}
      data-dtgraph-color-by={colorBy}
      data-dtgraph-chrome={String(chrome)}
      style={`height: ${height}`}
    >
      <script type="application/json" data-dtgraph-graph set:html={payload}></script>
    </div>
  )
}

<style>
  .dtgraph-mdx {
    position: relative;
    width: 100%;
    margin: 1rem 0;
    border-radius: 12px;
    overflow: hidden;
  }
</style>

<script>
  import { buildTokenGraph } from '@dtgraph/core';
  import type { TokenEdge, TokenNode } from '@dtgraph/core';
  import { injectViewerStyles, mountTokenGraphViewer } from '@dtgraph/viewer';
  import type { ColorBy, ThemeColors, TokenGraphViewer, ViewerTheme } from '@dtgraph/viewer';

  /** The theme the markup forces, if any: `"dark"`, `"light"` or a colors object. */
  function forcedTheme(preference: string | undefined): ViewerTheme | ThemeColors | undefined {
    if (preference === 'dark' || preference === 'light') return preference;
    if (preference?.startsWith('{')) return JSON.parse(preference) as ThemeColors;
    return undefined;
  }

  function siteTheme(): ViewerTheme {
    const site = document.documentElement.dataset.theme;
    if (site === 'dark' || site === 'light') return site;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function hydrate(container: HTMLElement): void {
    const source = container.querySelector<HTMLScriptElement>('script[data-dtgraph-graph]');
    if (source === null) return;
    const { nodes, edges } = JSON.parse(source.textContent ?? '{}') as {
      nodes: TokenNode[];
      edges: TokenEdge[];
    };
    const graph = buildTokenGraph(nodes, edges);
    const forced = forcedTheme(container.dataset.dtgraphTheme);
    const colorBy = (container.dataset.dtgraphColorBy ?? 'group') as ColorBy;
    const chrome = container.dataset.dtgraphChrome !== 'false';

    let viewer: TokenGraphViewer | undefined;
    let current: ViewerTheme | ThemeColors | undefined;
    const mount = (): void => {
      const theme = forced ?? siteTheme();
      if (theme === current) return;
      viewer?.destroy();
      current = theme;
      viewer = mountTokenGraphViewer(container, graph, { theme, colorBy, chrome });
    };
    mount();

    if (forced === undefined) {
      new MutationObserver(mount).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', mount);
    }
  }

  injectViewerStyles();
  for (const container of document.querySelectorAll<HTMLElement>('[data-dtgraph-interactive]')) {
    if (container.dataset.dtgraphMounted === 'true') continue;
    container.dataset.dtgraphMounted = 'true';
    hydrate(container);
  }
</script>
