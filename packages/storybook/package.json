{
  "name": "@dtgraph/storybook",
  "version": "0.1.0",
  "description": "Storybook addon: view a story's DTCG token graph in a panel",
  "license": "MIT",
  "author": "Julien D\u00e9ramond",
  "homepage": "https://github.com/julien-deramond/dtgraph#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/julien-deramond/dtgraph",
    "directory": "packages/storybook"
  },
  "bugs": {
    "url": "https://github.com/julien-deramond/dtgraph/issues"
  },
  "keywords": [
    "dtcg",
    "design-tokens",
    "design-system",
    "storybook-addons",
    "token-graph"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manager": "./dist/manager.js",
    "./preview": "./dist/preview.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "storybook": {
    "displayName": "dtgraph Token Graph",
    "supportedFrameworks": [
      "react",
      "vue3",
      "angular",
      "svelte",
      "web-components",
      "html",
      "ember",
      "preact"
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dtgraph/core": "workspace:^",
    "@dtgraph/viewer": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "storybook": "^10.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
