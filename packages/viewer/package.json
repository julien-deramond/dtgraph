{
  "name": "@dtgraph/viewer",
  "version": "0.1.0",
  "description": "Interactive WebGL explorer for DTCG token graphs: zoomable map, clusters, search, focus",
  "license": "MIT",
  "author": "Julien Déramond",
  "homepage": "https://github.com/julien-deramond/dtgraph#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/julien-deramond/dtgraph",
    "directory": "packages/viewer"
  },
  "bugs": {
    "url": "https://github.com/julien-deramond/dtgraph/issues"
  },
  "keywords": [
    "dtcg",
    "design-tokens",
    "design-system",
    "graph",
    "sigma",
    "token-graph",
    "visualization"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dtgraph/core": "workspace:^",
    "graphology": "0.26.0",
    "graphology-layout": "0.6.1",
    "graphology-layout-forceatlas2": "0.10.1",
    "sigma": "3.0.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "graphology-types": "0.24.8",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
